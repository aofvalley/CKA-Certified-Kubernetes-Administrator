ROOT = File.expand_path("../..", __dir__)
unless ENV["VAGRANT_DOTFILE_PATH"] == File.join(ROOT, ".lab/vms/vagrant")
  raise "Use bash scripts/vm-lab.sh from the repository root to select the isolated VM state."
end

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.vm.box_architecture = RUBY_PLATFORM.include?("arm64") ? "arm64" : "amd64"
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 600

  [
    ["controlplane", "192.168.57.10", 3072],
    ["node01", "192.168.57.11", 2560],
    ["node02", "192.168.57.12", 2560]
  ].each do |name, ip, memory|
    config.vm.define name do |vm|
      vm.vm.hostname = name
      vm.vm.network "private_network", ip: ip
      vm.vm.provider "virtualbox" do |vb|
        vb.name = "cka-vm-#{name}"
        vb.memory = memory
        vb.cpus = 2
        vb.gui = false
      end
      vm.vm.provision "shell",
        path: "bootstrap.sh",
        args: [ip, "1.34.11-1.1"]
    end
  end
end
